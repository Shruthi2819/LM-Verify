VITE_API_BASE_URL=http://localhost:8000/api

# Set to "true" to use local mock data instead of calling the backend.
# Use this during frontend development while the backend is being built.
# Set to "false" or remove when connecting to the real FastAPI backend.
VITE_USE_MOCK_DATA=true

# Never commit actual secrets to version control.
# Do NOT put JWT signing secrets, private keys,
# database credentials, blockchain private keys,
# or Supabase service-role keys here.
# Frontend environment variables are public (VITE_ prefix = bundled into JS).
